<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:navigationBarColor">@color/ui_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="AppDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:colorBackground">@color/ui_surface</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>
    <style name="AppDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
